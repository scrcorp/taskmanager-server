# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://root:root@localhost:40100/taskmanager

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated in env, or JSON array)
CORS_ORIGINS=["http://localhost:53000","http://localhost:58080","http://localhost:3000","http://localhost:8080","https://console.hermesops.site","https://app.hermesops.site"]

# Attendance Device access code (leave blank = server auto-generates on first boot and keeps value in DB)
# Set a value to force-override the DB entry on startup (source will be 'env').
ATTENDANCE_ACCESS_CODE=

# App
APP_NAME=HTM API
DEBUG=true

# Axiom (API Logging)
AXIOM_API_TOKEN=xaat-your-axiom-api-token
AXIOM_DATASET=your-dataset-name

# SMTP (Brevo)
# 1. Brevo 대시보드 → SMTP & API → SMTP 탭에서 키 발급
# 2. SMTP_USER: Brevo 계정 이메일
# 3. SMTP_PASSWORD: Brevo SMTP 키 (API 키와 다름)
# 4. SMTP_FROM_EMAIL: Brevo에서 인증된 발신 도메인/이메일
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-account@example.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=HTM

# ── 비-prod 이메일 안전장치 ──────────────────────────────────────────
# 이메일 수신자는 대부분 DB(User.email)에서 나온다. 로컬/워크트리 DB 는 dev
# 복사본이라 **실제 사람들의 주소**가 들어있으므로, 기능 하나만 눌러도 진짜
# 받은편지함으로 나간다. 그래서 APP_ENV 가 production 이 아니면:
#   - EMAIL_REDIRECT_TO 가 설정돼 있으면 모든 메일이 그 주소로 감
#     (제목 앞에 "[to: 원래수신자]" 가 붙어 누구에게 갈 메일이었는지 구분됨)
#   - 비어 있으면 **아예 발송하지 않는다** (기본 차단 — 깜빡해도 사고 없게)
# 로컬 개발 시에는 본인 주소를 넣어둘 것.
EMAIL_REDIRECT_TO=

# true 면 비-prod 에서도 실제 수신자에게 발송한다. 기본 false 로 둘 것 —
# 켜는 순간 DB 에 있는 실제 주소로 나간다.
EMAIL_SEND_REAL=false

# 주의: APP_ENV 가 빠져 있으면 local 로 간주돼 위 규칙에 따라 이메일이 차단된다.
#       운영/스테이징 서버 .env 에는 APP_ENV 를 반드시 명시할 것.

# 보고서 제출 알림 수신 이메일 (비어있으면 알림 미발송)
REPORT_NOTIFICATION_EMAIL=

# QA용 이메일 인증 우회 코드 (예: "000000")
# - 비어있으면 정상 동작 (실제 코드 발송 + 검증)
# - 설정되어 있으면:
#   1) SMTP 발송 skip (실제 메일 안 감, DB에는 코드 record는 남음)
#   2) verify-email-code 시 어떤 이메일이든 이 magic 코드 입력 시 통과
# 테스트/staging 환경에서만 사용. PROD .env 에는 절대 설정 금지 (인증 우회 가능).
EMAIL_VERIFICATION_TEST_CODE=

# 서버 배포 환경 — local | staging | production
# 이 서버가 어느 환경으로 떠 있는지. 백오피스 쿠키 secure 플래그 등이 참조.
APP_ENV=local

# HTMA(출퇴근 앱) 릴리스 채널 — local | staging | production
# 채널명 = attendance_{HTMA_TYPE}. release-attendance.sh 가 등록하는 채널명과
# 반드시 같아야 한다. 다르면 앱이 최신 APK 를 못 찾고 "이미 최신"으로 뜬다.
HTMA_TYPE=local

# Storage mode ("local" or "s3")
# s3 모드에서 access key 없으면 IAM role 사용 (EC2 배포 시)
STORAGE_MODE=local

# AWS S3 (File upload — presigned URL)
# access key 비어있으면 IAM role 사용 (EC2/ECS 배포 시 권장)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-west-2
# S3 fallback 버킷 — staging에서 파일이 없으면 여기서 복사 (prod 버킷)
# STORAGE_FALLBACK_BUCKET=

# 로컬 버킷 디렉토리 (local 모드에서 필수)
LOCAL_BUCKET_DIR=/path/to/project/bucket/dev
# 로컬 fallback 버킷 — worktree에서 파일이 없으면 여기서 복사 (dev 버킷)
# LOCAL_FALLBACK_BUCKET_DIR=

# Storage folder names (S3 key prefix / local subfolder)
# STORAGE_FOLDER_REVIEWS=reviews
# STORAGE_FOLDER_COMPLETIONS=completions
# STORAGE_FOLDER_PROFILES=profiles
# STORAGE_FOLDER_ANNOUNCEMENTS=announcements
# STORAGE_FOLDER_ISSUES=issues

# Server base URL (로컬 이미지 URL, presigned URL 등에서 사용, 비어있으면 http://localhost:8000)
# SERVER_BASE_URL=http://localhost:8000

# Admin console base URL (이메일 링크 등에서 사용)
ADMIN_BASE_URL=https://console.hermesops.site

# Excel templates (static/ 폴더 내 파일명, 비어있으면 기본값 사용)
# CHECKLIST_SAMPLE_EXCEL_PATH=checklist_template_sample.xlsx
# INVENTORY_TEMPLATE_EXCEL=inventory_import_template.xlsx

# ---------------------------------------------------------------------------
# Backoffice — 플랫폼 운영자 전용 평면 (org 권한 밖, vendor-internal)
# 비워두면 비활성(마운트 안 됨). prod/staging에서만 채운다.
# 외부 접근: https://api.hermesops.site/{BACKOFFICE_PATH}
# ---------------------------------------------------------------------------
# 비밀 URL 슬러그 — 추측 불가한 랜덤값 (예: openssl rand -hex 16). robots/링크에 노출 금지.
BACKOFFICE_PATH=
# 운영자 단일 계정
BACKOFFICE_ADMIN_USERNAME=
# bcrypt 해시 — 생성: python -c "from app.utils.password import hash_password; print(hash_password('YOUR_PW'))"
BACKOFFICE_ADMIN_PASSWORD_HASH=
# 세션 서명 시크릿 (비우면 JWT_SECRET_KEY 파생값 사용)
BACKOFFICE_SESSION_SECRET=
# 세션 유효 시간(분)
BACKOFFICE_SESSION_MAX_AGE_MINUTES=60
